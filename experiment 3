experiment 3- (a) to check whether a number is even or odd


#include <stdio.h>
int main() {
    int num;
    printf("enter the number:");
    scanf("%d",&num);
    if(num%2==0){
            printf("%d is even",num);
    }else {
          printf("%d is odd",num);
      }
      return 0;
    }





